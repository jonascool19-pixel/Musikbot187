[Unit]
Description=RadioBot network telemetry
After=network-online.target radiobot.service
Wants=network-online.target

[Service]
Type=simple
User=radiobot
Group=radiobot
ExecStart=/opt/radiobot/scripts/network-telemetry.sh
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/radiobot/frontend

[Install]
WantedBy=multi-user.target
