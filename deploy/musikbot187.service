[Unit]
Description=Musikbot 187
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=musikbot187
Group=musikbot187
WorkingDirectory=/opt/musikbot-187/backend
EnvironmentFile=/etc/musikbot-187/musikbot.env
ExecStart=/usr/bin/node /opt/musikbot-187/backend/dist/server.js
Restart=on-failure
RestartSec=3
MemoryMax=1G
CPUQuota=200%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/musikbot-187

[Install]
WantedBy=multi-user.target
