[Unit]
Description=RadioBot 4
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=radiobot
Group=radiobot
WorkingDirectory=/opt/radiobot/backend
Environment=NODE_ENV=production
Environment=RADIOBOT_DATA=/var/lib/radiobot
Environment=RADIOBOT_FRONTEND=/opt/radiobot/frontend
EnvironmentFile=-/etc/radiobot/radiobot.env
ExecStart=/usr/bin/node /opt/radiobot/backend/dist/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/radiobot
MemoryMax=1G
CPUQuota=200%
TasksMax=256
LimitNOFILE=65535
[Install]
WantedBy=multi-user.target