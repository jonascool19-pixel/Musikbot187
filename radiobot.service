[Unit]
Description=RadioBot music service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radiobot
Group=radiobot
WorkingDirectory=/opt/radiobot/backend
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/radiobot
Environment=FRONTEND_DIR=/opt/radiobot/frontend
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/radiobot/backend/dist/index.js
Restart=always
RestartSec=2
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/radiobot
MemoryMax=720M
CPUQuota=90%
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
