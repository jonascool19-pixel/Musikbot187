[Unit]
Description=RadioBot - low resource Discord radio service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radiobot
Group=radiobot
WorkingDirectory=/opt/radiobot
EnvironmentFile=/etc/radiobot/radiobot.env
Environment=NODE_ENV=production
Environment=APP_ROOT=/opt/radiobot
Environment=DATA_DIR=/var/lib/radiobot
Environment=NODE_OPTIONS=--max-old-space-size=192 --max-semi-space-size=1
Environment=UV_THREADPOOL_SIZE=1
ExecStart=/usr/bin/node /opt/radiobot/backend/dist/index.js
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/radiobot
MemoryHigh=420M
MemoryMax=480M
MemorySwapMax=0
CPUQuota=100%
TasksMax=64
LimitNOFILE=4096
Nice=5
UMask=0027
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
