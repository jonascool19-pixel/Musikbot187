{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "musikbot187-support-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "ratelimits": [
